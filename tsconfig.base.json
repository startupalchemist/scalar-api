{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@platform/engine/*": [
        "packages/engine/src/*"
      ],
      "@platform/contracts/*": [
        "packages/contracts/src/*"
      ],
      "@platform/config/*": [
        "packages/config/src/*"
      ]
    }
  }
}
